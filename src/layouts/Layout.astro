---
import { Font, getImage } from "astro:assets";
import ogCard from "../assets/og-card.svg";
import type { Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternatePath: string;
  skipText: string;
  noindex?: boolean;
}

const { title, description, locale, alternatePath, skipText, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const greekUrl = new URL(locale === "el" ? Astro.url.pathname : alternatePath, Astro.site);
const englishUrl = new URL(locale === "en" ? Astro.url.pathname : alternatePath, Astro.site);
const ogImage = await getImage({ src: ogCard, width: 1200, height: 630, format: "png" });
const favicon = await getImage({ src: ogCard, width: 64, height: 64, format: "png" });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "George Karanikolas",
  alternateName: "SeijinD",
  jobTitle: "Android & Kotlin Multiplatform Engineer",
  url: Astro.site?.href,
  image: ogImageUrl.href,
  address: { "@type": "PostalAddress", addressLocality: "Thessaloniki", addressCountry: "GR" },
  worksFor: { "@type": "Organization", name: "Arx.Net", url: "https://web.arx.net/" },
  sameAs: [
    "https://www.linkedin.com/in/seijind",
    "https://github.com/seijind",
    "https://medium.com/@seijind",
    "https://dev.to/seijind",
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={greekUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link rel="icon" href={favicon.src} type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#15120e" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="George Karanikolas, Android and Kotlin Multiplatform Engineer" />
    <meta property="og:locale" content={locale === "el" ? "el_GR" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "el" ? "en_GB" : "el_GR"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {locale === "el" ? (
      <>
        <Font cssVariable="--font-noto-serif" preload />
        <Font cssVariable="--font-noto-sans" preload />
      </>
    ) : (
      <>
        <Font cssVariable="--font-fraunces" preload />
        <Font cssVariable="--font-instrument" preload />
      </>
    )}
    <Font cssVariable="--font-jetbrains" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-lime focus:px-4 focus:py-2 focus:text-ink"
    >
      {skipText}
    </a>
    <slot />
    <script>
      console.log(
        "%cLooking under the hood?%c\nSource: https://github.com/SeijinD/seijind.github.io\nTry ↑ ↑ ↓ ↓ ← → ← → B A on this page.",
        "font: 600 16px serif; color: #c8f26a",
        "font: 12px monospace",
      );
    </script>
  </body>
</html>

---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";

interface Props {
  entries: CollectionEntry<"experience" | "education">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<ol class="divide-y divide-line">
  {
    entries.map(({ data }) => (
      <li class="grid gap-2 py-7 first:pt-0 last:pb-0 sm:grid-cols-[10rem_1fr] sm:gap-8">
        <p class="font-mono text-sm text-muted">{data.period[locale]}</p>
        <div>
          <h3 class="font-display text-xl font-medium leading-snug">{data.title[locale]}</h3>
          <p class="mt-1 text-muted">{data.place[locale]}</p>
          {data.points[locale].length > 0 && (
            <ul class="mt-3 space-y-1.5">
              {data.points[locale].map((point) => (
                <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-lime">
                  {point}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

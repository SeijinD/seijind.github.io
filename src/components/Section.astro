---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line py-16 md:py-20 lg:py-24">
  <div class="mx-auto grid max-w-6xl gap-7 px-5 md:px-8 lg:grid-cols-[11rem_1fr] lg:gap-12">
    <div>
      <div class="lg:sticky lg:top-24">
        <h2 id={`${id}-title`} class="font-display text-3xl font-medium tracking-tight lg:text-2xl">
          {title}
        </h2>
      </div>
    </div>
    <div>
      <slot />
    </div>
  </div>
</section>

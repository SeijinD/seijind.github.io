---
interface Props {
  data: {
    whoami: string;
    projects: { title: string; href: string }[];
    articles: { title: string; href: string }[];
    skills: { group: string; items: string[] }[];
    email: string;
    resume: string;
    ui: {
      title: string;
      close: string;
      command: string;
      intro: string;
      help: string;
      notFound: string;
      tryHelp: string;
      resume: string;
      permission: string;
      writeTo: string;
    };
  };
}

const { data } = Astro.props;
---

<dialog
  id="terminal"
  aria-labelledby="terminal-title"
  class="m-auto w-[min(42rem,calc(100vw-2rem))] rounded-xl border border-line bg-ink p-0 text-paper backdrop:bg-black/70"
>
  <div class="flex items-center justify-between border-b border-line px-4 py-2.5 font-mono text-xs text-muted">
    <h2 id="terminal-title">{data.ui.title}</h2>
    <form method="dialog">
      <button class="min-h-11 px-3 hover:text-lime" aria-label={data.ui.close}>esc</button>
    </form>
  </div>
  <div class="h-[min(24rem,60vh)] overflow-y-auto p-4 font-mono text-[0.8rem] leading-relaxed" data-scroll>
    <div data-output aria-live="polite"></div>
    <form class="flex min-h-11 items-center gap-2" data-prompt>
      <label for="terminal-input" class="sr-only">{data.ui.command}</label>
      <span class="text-lime" aria-hidden="true">$</span>
      <input
        id="terminal-input"
        class="min-h-11 min-w-0 flex-1 bg-transparent caret-lime outline-none"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="send"
      />
    </form>
  </div>
</dialog>

<script type="application/json" id="terminal-data" set:html={JSON.stringify(data)} />

<script>
  type TerminalData = {
    whoami: string;
    projects: { title: string; href: string }[];
    articles: { title: string; href: string }[];
    skills: { group: string; items: string[] }[];
    email: string;
    resume: string;
    ui: {
      title: string;
      close: string;
      command: string;
      intro: string;
      help: string;
      notFound: string;
      tryHelp: string;
      resume: string;
      permission: string;
      writeTo: string;
    };
  };

  const dialog = document.querySelector<HTMLDialogElement>("#terminal")!;
  const output = dialog.querySelector<HTMLElement>("[data-output]")!;
  const scroll = dialog.querySelector<HTMLElement>("[data-scroll]")!;
  const prompt = dialog.querySelector<HTMLFormElement>("[data-prompt]")!;
  const input = dialog.querySelector<HTMLInputElement>("#terminal-input")!;
  const data: TerminalData = JSON.parse(document.querySelector("#terminal-data")!.textContent!);

  const print = (...lines: (string | HTMLElement)[]) => {
    for (const line of lines) {
      const row = document.createElement("div");
      if (typeof line === "string") row.textContent = line;
      else row.append(line);
      output.append(row);
    }
    scroll.scrollTop = scroll.scrollHeight;
  };

  const link = (label: string, href: string) => {
    const a = document.createElement("a");
    a.href = href;
    a.textContent = label;
    a.className = "underline decoration-line underline-offset-4 hover:text-lime";
    return a;
  };

  const commands: Record<string, () => void> = {
    help: () => print(data.ui.help),
    whoami: () => print(data.whoami),
    projects: () => data.projects.forEach((p) => print(link(`- ${p.title}`, p.href))),
    articles: () => data.articles.forEach((a) => print(link(`- ${a.title}`, a.href))),
    skills: () => data.skills.forEach((s) => print(`${s.group}: ${s.items.join(", ")}`)),
    contact: () => print(link(data.email, `mailto:${data.email}`)),
    resume: () => print(link(data.ui.resume, data.resume)),
    clear: () => output.replaceChildren(),
    exit: () => dialog.close(),
    "sudo hire-george": () => print(data.ui.permission, link(`${data.ui.writeTo} ${data.email}`, `mailto:${data.email}`)),
  };

  prompt.addEventListener("submit", (event) => {
    event.preventDefault();
    const command = input.value.trim().toLowerCase();
    input.value = "";
    if (!command) return;
    print(`$ ${command}`);
    const run = commands[command];
    if (run) run();
    else print(`${data.ui.notFound}: ${command}. ${data.ui.tryHelp}`);
  });

  const open = () => {
    if (dialog.open) return;
    if (!output.hasChildNodes()) print(data.ui.intro);
    dialog.showModal();
    input.focus();
  };

  document.querySelectorAll("[data-open-terminal]").forEach((el) => el.addEventListener("click", open));

  const konami = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
  let progress = 0;
  window.addEventListener("keydown", (event) => {
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    progress = key === konami[progress] ? progress + 1 : key === konami[0] ? 1 : 0;
    if (progress === konami.length) {
      progress = 0;
      open();
    }
  });
</script>

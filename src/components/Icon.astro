---
export type IconName = "github" | "linkedin" | "medium" | "devdotto" | "mail";

interface Props {
  name: IconName;
  class?: string;
}

const icons = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });

const { name, class: className = "size-5" } = Astro.props;
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);

// Drop the <title> so the icon stays decorative; the link around it carries the label.
const svg = raw
  .replace(/<title>.*?<\/title>/, "")
  .replace(' role="img"', "")
  .replace("<svg ", `<svg class="${className}" fill="currentColor" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />

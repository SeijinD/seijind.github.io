---
import { Image } from "astro:assets";
import profile from "../assets/profile.jpg";
import FlipDemo from "./FlipDemo.astro";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  resume: string;
  socials: { label: string; href: string; icon: IconName }[];
  facts: { value: string; label: string }[];
}

const { resume, socials, facts } = Astro.props;
const chips = ["Kotlin", "Jetpack Compose", "Kotlin Multiplatform"];
---

<section id="top" class="mx-auto max-w-6xl px-5 pt-12 md:px-8 md:pt-16 lg:pt-12">
  <div class="grid items-center gap-14 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <div class="flex items-center gap-5">
        <Image
          src={profile}
          alt="George Karanikolas"
          width={96}
          height={96}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="size-20 rounded-full border-2 border-line object-cover sm:size-24"
        />
        <p class="font-mono text-xs uppercase leading-relaxed tracking-[0.14em] text-muted">
          Android & KMP Engineer<br />Thessaloniki, GR
        </p>
      </div>

      <h1 class="mt-8 font-display text-5xl font-normal leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
        George Karanikolas
      </h1>
      <p class="mt-6 max-w-[34ch] font-display text-2xl leading-snug text-paper/90 sm:text-3xl">
        I build Android apps where the UI <em class="text-lime">feels</em> right and the state <em class="text-lime"
          >is</em
        > right.
      </p>

      <ul class="mt-7 flex flex-wrap gap-2" aria-label="Core stack">
        {
          chips.map((chip) => (
            <li class="rounded-full border border-line px-3.5 py-1.5 font-mono text-xs text-paper">{chip}</li>
          ))
        }
      </ul>

      <ul class="mt-6 flex flex-wrap items-center gap-1" aria-label="Profiles">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                aria-label={s.label}
                class="grid size-11 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-lime"
              >
                <Icon name={s.icon} />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          class="inline-flex min-h-12 items-center rounded-full bg-lime px-6 font-medium text-ink transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          href={resume}>View resume</a
        >
        <a
          class="inline-flex min-h-12 items-center rounded-full border border-line px-6 font-medium transition-colors hover:border-paper"
          href="#work">See the work</a
        >
      </div>
    </div>

    <FlipDemo />
  </div>

  <dl class="mt-16 grid grid-cols-2 gap-px border-y border-line bg-line sm:grid-cols-3 lg:mt-12 lg:grid-cols-5">
    {
      facts.map((f) => (
        <div class="flex flex-col-reverse justify-end gap-2 bg-ink px-4 py-6 last:col-span-2 lg:last:col-span-1 lg:px-5">
          <dt class="text-sm leading-snug text-muted">{f.label}</dt>
          <dd class="font-display text-3xl leading-none tracking-tight text-lime md:text-4xl">{f.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

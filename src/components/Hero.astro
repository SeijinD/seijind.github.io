---
import { Image } from "astro:assets";
import profile from "../assets/profile.jpg";
import type { getUi } from "../i18n";
import FlipDemo from "./FlipDemo.astro";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  resume: string;
  socials: { label: string; href: string; icon: IconName }[];
  copy: ReturnType<typeof getUi>["hero"];
  flipCopy: ReturnType<typeof getUi>["demo"]["flip"];
}

const { resume, socials, copy, flipCopy } = Astro.props;
---

<section id="top" class="mx-auto max-w-6xl px-5 pb-16 pt-10 md:px-8 md:pb-20 md:pt-14 lg:pt-12">
  <div class="hero-grid grid gap-10 lg:items-center lg:gap-x-14 lg:gap-y-12">
    <div class="hero-intro">
      <div class="flex items-center gap-5">
        <Image
          src={profile}
          alt="George Karanikolas"
          width={96}
          height={96}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="size-20 rounded-full border-2 border-line object-cover sm:size-24"
        />
        <p class="font-mono text-xs uppercase leading-relaxed tracking-[0.14em] text-muted">
          {copy.role}<br />{copy.location}
        </p>
      </div>

      <h1 class="mt-7 max-w-[14ch] font-display text-5xl font-normal leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
        George Karanikolas
      </h1>
      <p class="mt-5 max-w-[36ch] text-balance font-display text-2xl leading-snug text-paper/90 sm:text-3xl">
        {copy.taglineStart} <em class="text-lime">{copy.taglineFeels}</em> {copy.taglineMiddle} <em class="text-lime"
          >{copy.taglineIs}</em
        > {copy.taglineEnd}
      </p>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label={copy.stackLabel}>
        {copy.chips.map((chip) => <li class="rounded-full border border-line px-3.5 py-1.5 font-mono text-xs">{chip}</li>)}
      </ul>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          class="inline-flex min-h-12 items-center rounded-full bg-lime px-6 font-medium text-ink transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          href={resume}>{copy.resume}</a
        >
        <a
          class="inline-flex min-h-12 items-center rounded-full border border-line px-6 font-medium transition-colors hover:border-paper"
          href="#work">{copy.work}</a
        >
        <ul class="flex items-center gap-1" aria-label={copy.profilesLabel}>
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                class="grid size-11 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-lime"
              >
                <Icon name={social.icon} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="hero-proof grid gap-px border-y border-line bg-line sm:grid-cols-2" aria-label={copy.proofLabel}>
      {copy.proof.map(([value, label]) => (
        <li class="bg-ink px-4 py-4 md:px-5">
          <strong class="block font-display text-xl font-medium leading-tight text-lime">{value}</strong>
          <span class="mt-1 block text-sm leading-snug text-muted">{label}</span>
        </li>
      ))}
    </ul>

    <div class="hero-demo">
      <FlipDemo copy={flipCopy} />
    </div>
  </div>
</section>

<style>
  .hero-intro {
    grid-area: intro;
  }

  .hero-proof {
    grid-area: proof;
  }

  .hero-demo {
    grid-area: demo;
  }

  .hero-grid {
    grid-template-areas:
      "intro"
      "proof"
      "demo";
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 1.3fr 1fr;
      grid-template-areas:
        "intro demo"
        "proof proof";
    }
  }
</style>

---
// Mirrors the snippet in the GitHub profile README, highlighted by hand to avoid a highlighter dependency.
---

<figure class="overflow-hidden rounded-xl border border-line bg-surface">
  <figcaption class="flex items-center gap-2 border-b border-line px-4 py-3 font-mono text-xs text-muted">
    <span class="size-2.5 rounded-full bg-line" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-line" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-line" aria-hidden="true"></span>
    <span class="ml-2">George.kt</span>
  </figcaption>
  <pre tabindex="0"
    class="overflow-x-auto p-5 font-mono text-[0.8rem] leading-relaxed sm:text-sm"><code><span class="kw">val</span> george = <span class="fn">Developer</span>(
    <span class="arg">name</span> = <span class="str">"George Karanikolas"</span>,
    <span class="arg">role</span> = <span class="str">"Android &amp; KMP Engineer"</span>,
    <span class="arg">location</span> = <span class="str">"Thessaloniki, Greece"</span>,
    <span class="arg">focuses</span> = <span class="fn">listOf</span>(
        <span class="str">"Kotlin"</span>,
        <span class="str">"Jetpack Compose"</span>,
        <span class="str">"KMP"</span>,
        <span class="str">"Clean Architecture"</span>,
        <span class="str">"Ktor"</span>,
    ),
    <span class="arg">currentlyExploring</span> = <span class="str">"Kotlin Multiplatform"</span>,
)</code></pre>
</figure>

<style>
  pre {
    color: var(--color-paper);
  }
  .kw {
    color: #e0a86f;
  }
  .fn {
    color: var(--color-lime);
  }
  .arg {
    color: #a9b8d8;
  }
  .str {
    color: #9fd3a8;
  }
</style>

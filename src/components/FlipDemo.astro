---
const cards = Array.from({ length: 6 }, (_, i) => i + 1);
---

<figure class="flip-demo mx-auto w-full max-w-[17rem]" aria-labelledby="flip-demo-caption">
  <div
    class="rounded-[2.75rem] border border-line bg-surface p-3 shadow-[0_30px_80px_-40px_rgba(200,242,106,0.25)]"
  >
    <div class="rounded-[2.1rem] border border-line bg-ink px-4 pb-5 pt-4">
      <div class="mx-auto mb-5 h-1.5 w-16 rounded-full bg-line" aria-hidden="true"></div>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">Flip To Win</p>
      <p class="mb-4 mt-1 min-h-[3.2em] font-display text-xl leading-tight" data-status aria-live="polite">
        Pick a card.
      </p>

      <div class="grid grid-cols-2 gap-3" data-board>
        {
          cards.map((n) => (
            <button type="button" class="card aspect-[5/6] lg:aspect-square" data-card data-state="idle" aria-label={`Card ${n}`}>
              <span class="card-inner">
                <span class="face face-back">
                  <span class="font-display text-3xl italic">?</span>
                </span>
                <span class="face face-front">
                  <span class="font-display text-lg leading-tight" data-prize />
                </span>
              </span>
            </button>
          ))
        }
      </div>

      <button
        type="button"
        class="mt-4 hidden min-h-11 w-full rounded-full border border-line font-mono text-xs uppercase tracking-[0.14em] text-paper transition-colors hover:border-lime hover:text-lime"
        data-reset
      >
        Play again
      </button>
    </div>
  </div>
  <figcaption id="flip-demo-caption" class="mt-4 text-center font-mono text-xs leading-relaxed text-muted">
    A working sketch of Flip To Win: the reward is claimed before the card turns.{" "}
    <a
      class="link-underline text-paper"
      href="https://medium.com/@seijind/claim-before-you-reveal-engineering-a-flip-to-win-experience-in-jetpack-compose-6f4f6e9fece6"
      >How it works</a
    >
  </figcaption>
</figure>

<style>
  .card {
    perspective: 800px;
    cursor: pointer;
    border-radius: 0.9rem;
  }

  .card:disabled {
    cursor: default;
  }

  .card-inner {
    position: relative;
    display: block;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    backface-visibility: hidden;
    text-align: center;
  }

  .face-back {
    background:
      repeating-linear-gradient(45deg, transparent 0 6px, rgb(255 255 255 / 0.03) 6px 7px),
      var(--color-surface);
    color: var(--color-muted);
    transition:
      border-color 150ms ease-out,
      color 150ms ease-out;
  }

  .face-front {
    background: var(--color-lime);
    color: var(--color-ink);
    border-color: var(--color-lime);
    transform: rotateY(180deg);
  }

  @media (hover: hover) {
    .card:not(:disabled):hover .face-back {
      border-color: var(--color-lime);
      color: var(--color-lime);
    }
  }

  .card[data-state="claiming"] .face-back {
    border-color: var(--color-lime);
    color: var(--color-lime);
    animation: claim-pulse 700ms ease-in-out infinite alternate;
  }

  .card[data-state="revealed"] .card-inner {
    transform: rotateY(180deg);
  }

  .card[data-state="locked"] {
    opacity: 0.45;
  }

  @keyframes claim-pulse {
    to {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-inner {
      transition: none;
    }

    .card[data-state="revealed"] .card-inner {
      transform: none;
    }

    .face-front {
      transform: none;
      opacity: 0;
    }

    .card[data-state="revealed"] .face-front {
      opacity: 1;
    }

    .card[data-state="claiming"] .face-back {
      animation: none;
    }
  }
</style>

<script>
  const prizes = ["50 coins", "Mystery box", "Free retry", "Trophy"];
  // Stands in for the claim API round trip that has to finish before the reveal.
  const claimDelayMs = 700;

  for (const demo of document.querySelectorAll<HTMLElement>(".flip-demo")) {
    const status = demo.querySelector<HTMLElement>("[data-status]")!;
    const reset = demo.querySelector<HTMLButtonElement>("[data-reset]")!;
    const cards = [...demo.querySelectorAll<HTMLButtonElement>("[data-card]")];

    const setAll = (state: string) =>
      cards.forEach((card) => {
        card.dataset.state = state;
        card.disabled = state !== "idle";
      });

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        if (card.dataset.state !== "idle") return;
        setAll("locked");
        card.dataset.state = "claiming";
        status.textContent = "Claiming reward…";

        window.setTimeout(() => {
          const prize = prizes[Math.floor(Math.random() * prizes.length)];
          card.querySelector<HTMLElement>("[data-prize]")!.textContent = prize;
          card.dataset.state = "revealed";
          card.setAttribute("aria-label", `Revealed: ${prize}`);
          status.textContent = `Claimed, then revealed: ${prize}.`;
          reset.classList.remove("hidden");
        }, claimDelayMs);
      });
    });

    reset.addEventListener("click", () => {
      setAll("idle");
      cards.forEach((card, i) => card.setAttribute("aria-label", `Card ${i + 1}`));
      status.textContent = "Pick a card.";
      reset.classList.add("hidden");
      cards[0].focus();
    });
  }
</script>
